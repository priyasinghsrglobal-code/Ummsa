FROM python:3.12-slim
WORKDIR /app
COPY web_requirements.txt .
RUN pip install --no-cache-dir -r web_requirements.txt
COPY engine.py web_engine.py webapp.py ./
COPY web ./web
ENV PYTHONUNBUFFERED=1 UMMSA_DB=/data/ummsa.sqlite3
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 8 --timeout 60 webapp:app"]
